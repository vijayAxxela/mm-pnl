# Copy to .env (repo root, gitignored) on the machine that runs
# `docker compose up`. docker-compose auto-loads this file — these are NOT
# used by local (non-Docker) development, which reads backend/.env instead.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tt_pnl_dashboard

TT_API_KEY=<your TT app key>
TT_API_SECRET=<your TT app secret>
TT_ENVIRONMENT=ext_prod_live

TRADING_DAY_START_TIME=06:00
