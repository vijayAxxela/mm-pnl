# Copy to .env (repo root, gitignored). One file for both local (non-Docker)
# dev — `uv run python main.py` from backend/ — and local `docker compose
# up` on this machine; backend/database/db.py loads this file explicitly by
# absolute path regardless of which one you're running.
#
# Prod is the one exception: it reads a separate file kept OUTSIDE the repo
# (C:\actions-runner-mmpnl\deploy.env on the deploy machine) because
# actions/checkout wipes anything inside the checked-out repo dir on every
# deploy, including gitignored files. Keep that file's contents in sync with
# this one by hand.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tt_pnl_dashboard_docker

# Local non-Docker dev only — Docker computes its own DATABASE_URL from
# POSTGRES_* above (pointed at the `db` service hostname), so this has no
# effect inside Docker. No local/sqlite fallback; Postgres is required.
DATABASE_URL=postgresql+psycopg://<user>:<password>@localhost:5432/<dbname>

TT_API_KEY=<your TT app key>
TT_API_SECRET=<your TT app secret>
TT_ENVIRONMENT=ext_prod_live

# What time (IST, HH:MM) a "trading day" starts — used for the fill-sync
# scheduler's window, PNL start-date filtering, account backfill, the Fills
# page date range, and the Day-Open-PNL snapshot (fires 15 min after this).
# Defaults to 06:00 if unset.
TRADING_DAY_START_TIME=06:00

# Local non-Docker dev only. Docker's backend always runs on 8020
# (hardcoded in docker-compose.yml) regardless of this — the two are
# isolated so you can run both a local `python main.py` and
# `docker compose up` on the same machine at once without a port collision.
PORT=8021

# SMTP for combined-loss email alerts (see backend/routes/alerts.py —
# recipients and the loss thresholds themselves are configured from the
# frontend's Loss Alerts panel, not here). Optional: without SMTP_HOST set,
# email alerts are skipped (logged as a warning) but the sound alert and
# everything else still works. A Gmail account needs an "app password", not
# your normal login password, if using smtp.gmail.com.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<your account>
SMTP_PASSWORD=<app password>
SMTP_FROM=<from address, defaults to SMTP_USER>
