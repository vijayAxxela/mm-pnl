# Applies to the backend image's build context (repo root — see
# docker-compose.yml's `context: .`). frontend/.dockerignore is separate
# and applies to the frontend image's own context (./frontend).
.git
.github
frontend/node_modules
frontend/dist
backend/__pycache__
backend/.venv
backend/.env
backend/*.db
.venv
*.ipynb
*.ipynb_checkpoints
*.csv
