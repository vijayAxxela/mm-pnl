# Copy to backend/.env and fill in — required (Postgres only, no local
# fallback). If unset, the app falls back to database.url in config.json.
#
# DATABASE_URL=postgresql+psycopg2://<user>:<password>@localhost:5432/<dbname>

# What time (IST, HH:MM) a "trading day" starts — used for the fill-sync
# scheduler's window, PNL start-date filtering, account backfill, the Fills
# page date range, and the Day-Open-PNL snapshot (fires 15 min after this).
# Defaults to 06:00 if unset.
#
# TRADING_DAY_START_TIME=06:00

# TT API credentials — required, no safe fallback. config.json only holds a
# placeholder for these two so it can be committed; the real values must
# come from here (local dev) or from Docker Compose's environment (prod).
#
# TT_API_KEY=<your TT app key>
# TT_API_SECRET=<your TT app secret>
# TT_ENVIRONMENT=ext_prod_live

# Local dev only. Docker always runs on 8020 (config.json's default) no
# matter what this is set to — the two are isolated so you can run both a
# local `python main.py` and `docker compose up` on the same machine at
# once without a port collision.
#
# PORT=8021
